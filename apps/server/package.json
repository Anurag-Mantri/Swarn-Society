{
  "name": "@swarmroom/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:integration": "node -e \"if (!process.env.TEST_DATABASE_URL) { console.error('Set TEST_DATABASE_URL to a disposable *_test database'); process.exit(1) }\" && vitest run src/integration.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "@hocuspocus/server": "^4.9.0",
    "@swarmroom/protocol": "workspace:*",
    "drizzle-orm": "^0.44.3",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "yjs": "^13.6.33",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "ws": "8.23.0"
  }
}
