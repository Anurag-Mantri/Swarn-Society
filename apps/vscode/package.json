{
  "name": "swarmroom-snapshot-status",
  "displayName": "Swarmroom Snapshot Status",
  "description": "Compare a VS Code checkout and commit with its Swarmroom snapshot branch.",
  "publisher": "swarmroom",
  "version": "0.1.0",
  "private": true,
  "engines": { "vscode": "^1.96.0" },
  "main": "./dist/extension.cjs",
  "extensionKind": ["workspace"],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Snapshot status uses a local Git checkout and the installed host daemon CLI."
    }
  },
  "contributes": {
    "commands": [{
      "command": "swarmroom.snapshotStatus",
      "title": "Check Workspace Snapshot Status",
      "category": "Swarmroom",
      "enablement": "isWorkspaceTrusted"
    }],
    "configuration": {
      "title": "Swarmroom",
      "properties": {
        "swarmroom.snapshotStatus.daemonCli": {
          "type": "string",
          "scope": "machine",
          "description": "Absolute path to the installed daemon's dist/github/cli.js."
        },
        "swarmroom.snapshotStatus.appId": { "type": "string", "scope": "machine", "description": "GitHub App ID." },
        "swarmroom.snapshotStatus.installationId": { "type": "string", "scope": "machine", "description": "GitHub App installation ID." },
        "swarmroom.snapshotStatus.repositoryId": { "type": "string", "scope": "machine", "description": "GitHub repository ID." },
        "swarmroom.snapshotStatus.workspaceId": { "type": "string", "scope": "machine", "description": "Swarmroom workspace UUID." }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --target=node20 --external:vscode --outfile=dist/extension.cjs",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "1.96.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  }
}
